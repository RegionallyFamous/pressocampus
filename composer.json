{
    "name": "pressocampus/pressocampus",
    "description": "Turn WordPress into your AI's persistent memory store",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "league/oauth2-server": "^9.3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "build": "bash bin/build.sh",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit test suite",
        "test:coverage": "Run tests with code coverage report",
        "lint": "Check coding standards with PHPCS",
        "lint:fix": "Auto-fix coding standards with PHPCBF",
        "analyse": "Run PHPStan static analysis",
        "build": "Build distributable plugin zip",
        "check": "Run lint + analyse + test (full CI check)"
    }
}
